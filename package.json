{
  "name": "mangasoft",
  "version": "1.5.0",
  "license": "GPL-3.0-or-later",
  "description": "Self-hosted manga, anime and light novel server with a web reader, AniList tracking and on-the-fly video transcoding",
  "author": "Itsukos",
  "homepage": "https://github.com/Itsukos/MangaSoft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itsukos/MangaSoft.git"
  },
  "bugs": {
    "url": "https://github.com/Itsukos/MangaSoft/issues"
  },
  "keywords": [
    "manga",
    "anime",
    "light-novel",
    "epub",
    "self-hosted",
    "media-server",
    "anilist",
    "cbz",
    "reader"
  ],
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --no-warnings server/run.js",
    "dev": "node --no-warnings server/index.js",
    "build:vendor": "node scripts/build-vendor.mjs",
    "release": "node release/build.js",
    "publish-update": "node release/publish.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "hls.js": "^1.7.3",
    "jassub": "^2.5.20",
    "node-stream-zip": "^1.15.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.2"
  },
  "optionalDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0"
  }
}
